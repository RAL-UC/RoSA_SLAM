<!-- cloud_pose_mapper.launch -->
<launch>
  <param name="use_sim_time" value="true"/>

  <node pkg="path_publisher" type="cloud_pose_mapper" name="cloud_pose_mapper" output="screen">
    <param name="cloud_topic" value="/velodyne_points"/> <!--"/os_cloud_node/points" "/velodyne_points" -->
    <param name="pose_topic"  value="/pose"/>
    <param name="pose_type"   value="Odometry"/>  <!-- or PoseStamped -->
    <param name="map_frame"   value="map"/>
    
    <!-- keep only -3.0 .. +3.0 rad (i.e., almost full circle) -->
    <param name="enable_yaw_filter" value="true"/>
    <param name="yaw_min" value="-2.4"/> <!-- -2.4 -->
    <param name="yaw_max" value="2.4"/> <!-- 2.4 -->
    <param name="yaw_invert" value="false"/>

    <param name="enable_downsample" value="false"/>
    <param name="voxel_leaf" value="0.0"/>   <!-- ignored when disabled -->

    <!-- base_link -> lidar extrinsic if needed -->
    <param name="extrinsic_xyz" value="[0.0, 0.0, 0.0]"/>
    <param name="extrinsic_rpy" value="[0.0, 0.0, 0.0]"/>

    <param name="voxel_leaf" value="0.08"/>
    <param name="publish_every_n" value="5"/>
    <param name="max_points" value="2500000"/>
    <param name="min_range"  value="0.0"/>

    <param name="max_range"  value="1000000000.0"/>  <!-- 1e9 -->
    <param name="range_mode" value="xy"/>
    <param name="z_min"      value="-1000000000.0"/> <!-- 0.0 -->
    <param name="z_max"      value="1000000000.0"/>

    <param name="save_dir"  value="$(env HOME)/maps"/>
    <param name="save_name" value="run1_map"/>
  </node>
   <node
        name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(find path_publisher)/rviz/config.rviz"
        output="screen" />
</launch>

